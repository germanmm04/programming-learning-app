<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Codelingo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Codelingo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_app</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Codelingo</item>
    </style>
</resources>